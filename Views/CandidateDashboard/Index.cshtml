@model AIRecruitmentSystem.Controllers.CandidateDashboardViewModel

@{
    Layout = null;
    ViewData["Title"] = "Candidate Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Candidate Dashboard | AI Recruitment System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --bg: #090c14;
            --surface: #111622;
            --card: #171d2a;
            --border: rgba(255,255,255,.09);
            --text: #f4f6fc;
            --muted: #a4aec1;
            --accent: #8ab4ff;
            --purple: #8b7cff;
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            background: var(--bg);
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: radial-gradient(ellipse at 12% 0%, rgba(77,83,190,.19), transparent 35%), radial-gradient(ellipse at 90% 80%, rgba(26,116,126,.10), transparent 30%), var(--bg);
        }

        a {
            text-decoration: none;
        }

        .page-shell {
            width: 100%;
            min-height: 100vh;
            padding: 38px 24px 60px;
        }

        .dashboard {
            width: 100%;
            max-width: 1380px;
            margin: 0 auto;
            padding: clamp(24px, 5vw, 64px);
            border: 1px solid var(--border);
            border-radius: 28px;
            background: rgba(17,22,34,.94);
            box-shadow: 0 30px 100px rgba(0,0,0,.28);
            animation: enter .6s ease both;
        }

        .top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 48px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text);
            font-size: 15px;
            font-weight: 800;
            letter-spacing: .2px;
        }

        .brand-mark {
            display: grid;
            width: 42px;
            height: 42px;
            place-items: center;
            border: 1px solid rgba(139,124,255,.4);
            border-radius: 13px;
            background: rgba(139,124,255,.13);
            color: #c3baff;
            font-size: 19px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 13px;
            border: 1px solid var(--border);
            border-radius: 30px;
            color: #c6d0e1;
            background: rgba(255,255,255,.035);
            font-size: 12px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #54d99a;
            box-shadow: 0 0 12px rgba(84,217,154,.55);
        }

        .eyebrow {
            color: #a99cff;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .hero-title {
            margin: 15px 0 12px;
            color: var(--text);
            font-size: clamp(34px, 5vw, 58px);
            font-weight: 800;
            letter-spacing: -2.3px;
            line-height: 1.12;
        }

            .hero-title span {
                color: #a99cff;
            }

        .hero-description {
            max-width: 690px;
            margin: 0;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.8;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin: 36px 0 44px;
        }

        .stat-card {
            position: relative;
            overflow: hidden;
            padding: 24px;
            border: 1px solid var(--border);
            border-radius: 20px;
            background: linear-gradient(140deg, #1a2030, #141a26);
            transition: transform .25s ease, border-color .25s ease;
        }

            .stat-card:hover {
                transform: translateY(-4px);
                border-color: rgba(169,156,255,.4);
            }

        .stat-label {
            color: var(--muted);
            font-size: 13px;
            font-weight: 500;
        }

        .stat-value {
            margin-top: 14px;
            color: var(--text);
            font-size: 36px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .section-heading {
            margin-bottom: 20px;
            color: var(--text);
            font-size: 20px;
            font-weight: 750;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .feature-card {
            display: flex;
            min-width: 0;
            flex-direction: column;
            padding: 27px;
            border: 1px solid var(--border);
            border-radius: 22px;
            background: linear-gradient(145deg, #1a202d, #141a26);
            transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
        }

            .feature-card:hover {
                transform: translateY(-5px);
                border-color: rgba(138,180,255,.4);
                box-shadow: 0 18px 40px rgba(0,0,0,.18);
            }

        .feature-icon {
            display: grid;
            width: 49px;
            height: 49px;
            margin-bottom: 24px;
            place-items: center;
            border: 1px solid rgba(138,180,255,.2);
            border-radius: 15px;
            background: rgba(138,180,255,.09);
            color: var(--accent);
            font-size: 23px;
        }

        .feature-card h3 {
            margin-bottom: 12px;
            color: var(--text);
            font-size: 20px;
            font-weight: 750;
        }

        .feature-card p {
            flex-grow: 1;
            margin-bottom: 25px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.85;
        }

        .feature-link {
            display: inline-flex;
            align-items: center;
            align-self: flex-start;
            gap: 9px;
            color: var(--accent);
            font-size: 14px;
            font-weight: 700;
            transition: gap .2s ease, color .2s ease;
        }

            .feature-link:hover {
                gap: 15px;
                color: #c3d9ff;
            }

        /* AI Job Matching card */
        .ai-match-card {
            border-color: rgba(139,124,255,.35);
            background: radial-gradient(ellipse at 100% 0%, rgba(139,124,255,.13), transparent 55%), linear-gradient(145deg, #1c2034, #141a26);
        }

            .ai-match-card .feature-icon {
                border-color: rgba(139,124,255,.35);
                background: rgba(139,124,255,.14);
                color: #b8adff;
            }

            .ai-match-card .feature-link {
                color: #b8adff;
            }

                .ai-match-card .feature-link:hover {
                    color: #d5ceff;
                }

        .profile-section {
            margin-top: 38px;
            padding: 25px;
            border: 1px solid var(--border);
            border-radius: 20px;
            background: rgba(255,255,255,.025);
        }

        .profile-heading {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 17px;
            color: var(--text);
            font-size: 14px;
            font-weight: 700;
        }

            .profile-heading span:last-child {
                color: #b8adff;
            }

        .profile-track {
            height: 8px;
            overflow: hidden;
            border-radius: 20px;
            background: #292e3d;
        }

        .profile-fill {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #8172ff, #63d7c1);
            transition: width .5s ease;
        }

        .bottom-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 38px;
            padding-top: 25px;
            border-top: 1px solid var(--border);
        }

        .footer-note {
            color: #7f899e;
            font-size: 12px;
        }

        .logout-button {
            padding: 10px 19px;
            border: 1px solid rgba(255,255,255,.17);
            border-radius: 12px;
            background: rgba(255,255,255,.04);
            color: #e5e9f4;
            font-size: 13px;
            font-weight: 700;
            transition: background .2s ease, border-color .2s ease;
        }

            .logout-button:hover {
                border-color: rgba(255,255,255,.35);
                background: rgba(255,255,255,.10);
            }

        @@keyframes enter {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 900px) {
            .feature-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .stats-grid {
                gap: 12px;
            }
        }

        @@media (max-width: 600px) {
            .page-shell {
                padding: 14px 10px 30px;
            }

            .dashboard {
                padding: 25px 18px;
                border-radius: 21px;
            }

            .top-row {
                margin-bottom: 35px;
            }

            .hero-title {
                letter-spacing: -1.3px;
            }

            .stats-grid,
            .feature-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                margin: 27px 0 34px;
            }

            .stat-card {
                padding: 20px;
            }

            .stat-value {
                font-size: 30px;
            }

            .feature-card {
                padding: 23px;
            }

            .profile-section {
                padding: 20px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>
    <main class="page-shell">
        <div class="dashboard">

            <header class="top-row">
                <div class="brand">
                    <div class="brand-mark">✦</div>
                    <span>AI Recruitment System</span>
                </div>

                <div class="status">
                    <span class="status-dot"></span>
                    Candidate workspace
                </div>
            </header>

            <section>
                <div class="eyebrow">Your career starts here</div>

                <h1 class="hero-title">
                    Candidate <span>Dashboard</span>
                </h1>

                <p class="hero-description">
                    Welcome, @(string.IsNullOrWhiteSpace(Model.FullName)
                                        ? "Candidate"
                                        : Model.FullName)!
                    Manage your professional profile, upload your resume,
                    and discover job opportunities matched to your skills.
                </p>
            </section>

            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Active opportunities</div>
                    <div class="stat-value">@Model.TotalActiveJobs</div>
                </div>

                <div class="stat-card">
                    <div class="stat-label">Applications submitted</div>
                    <div class="stat-value">@Model.TotalApplications</div>
                </div>

                <div class="stat-card">
                    <div class="stat-label">Resumes uploaded</div>
                    <div class="stat-value">@Model.TotalResumes</div>
                </div>
            </section>

            <section>
                <h2 class="section-heading">Your career workspace</h2>

                <div class="feature-grid">

                    <!-- My Profile -->
                    <article class="feature-card">
                        <div class="feature-icon" aria-hidden="true">◎</div>

                        <h3>My Profile</h3>

                        <p>
                            Keep your education, experience, skills,
                            preferred location and portfolio information
                            up to date.
                        </p>

                        <a asp-controller="CandidateProfile"
                           asp-action="Index"
                           class="feature-link">
                            Edit profile <span aria-hidden="true">→</span>
                        </a>
                    </article>

                    <!-- My Resume -->
                    <article class="feature-card">
                        <div class="feature-icon" aria-hidden="true">▤</div>

                        <h3>My Resume</h3>

                        <p>
                            Upload and manage your resume. Extracted skills
                            can help compare your profile with job requirements.
                        </p>

                        <a asp-controller="Resume"
                           asp-action="Index"
                           class="feature-link">
                            Manage resumes <span aria-hidden="true">→</span>
                        </a>
                    </article>

                    <!-- AI Job Matching -->
                    <article class="feature-card ai-match-card">
                        <div class="feature-icon" aria-hidden="true">✧</div>

                        <h3>AI Job Matching</h3>

                        <p>
                            Compare your resume with active job openings.
                            Get an AI-estimated match score, identify missing
                            skills and discover practical ways to improve your fit.
                        </p>

                        <a asp-controller="JobMatching"
                           asp-action="Index"
                           class="feature-link">
                            Analyze job match <span aria-hidden="true">→</span>
                        </a>
                    </article>

                    <!-- Find Jobs -->
                    <article class="feature-card">
                        <div class="feature-icon" aria-hidden="true">⌕</div>

                        <h3>Find Jobs</h3>

                        <p>
                            Browse active job openings, view skill-match
                            percentages and discover skills you may need
                            to improve.
                        </p>

                        <a asp-controller="CandidateJobs"
                           asp-action="Index"
                           class="feature-link">
                            Explore matching jobs <span aria-hidden="true">→</span>
                        </a>
                    </article>

                    <!-- My Applications -->
                    <article class="feature-card">
                        <div class="feature-icon" aria-hidden="true">✓</div>

                        <h3>My Applications</h3>

                        <p>
                            Track all your submitted job applications.
                            Check whether an application is under review,
                            shortlisted, rejected or marked as hired.
                        </p>

                        <a asp-controller="CandidateApplications"
                           asp-action="Index"
                           class="feature-link">
                            Track applications <span aria-hidden="true">→</span>
                        </a>
                    </article>

                </div>
            </section>

            <section class="profile-section">
                <div class="profile-heading">
                    <span>Profile completion</span>
                    <span>@Model.ProfileCompletion%</span>
                </div>

                <div class="profile-track"
                     role="progressbar"
                     aria-label="Profile completion"
                     aria-valuenow="@Model.ProfileCompletion"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <div class="profile-fill"
                         style="width: @Math.Clamp(Model.ProfileCompletion, 0, 100)%;">
                    </div>
                </div>
            </section>

            <footer class="bottom-row">
                <div class="footer-note">
                    AI Recruitment System · Candidate workspace
                </div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="logout-button">
                        Logout ↗
                    </button>
                </form>
            </footer>

        </div>
    </main>
</body>
</html>