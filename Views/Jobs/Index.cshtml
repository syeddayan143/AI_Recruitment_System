@model IEnumerable<AIRecruitmentSystem.Models.Job>

@{
    ViewData["Title"] = "My Jobs";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="text-white fw-bold mb-1">My Jobs</h1>
            <p class="text-secondary mb-0">
                Manage your job postings in one place.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="RecruiterDashboard"
               asp-action="Index"
               class="btn btn-outline-light">
                Dashboard
            </a>

            <a asp-controller="Jobs"
               asp-action="Create"
               class="btn btn-primary">
                + Post New Job
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header border-secondary py-3">
            <h5 class="mb-0">Your Job Listings</h5>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Job Title</th>
                                <th>Department</th>
                                <th>Location</th>
                                <th>Employment Type</th>
                                <th>Posted Date</th>
                                <th>Closing Date</th>
                                <th>Status</th>
                                <th style="min-width: 210px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var job in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@job.Title</td>

                                    <td>@job.Department</td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(job.Location)
                                                                        ? "Not specified"
                                                                        : job.Location)
                                                                                   </td>

                                    <td>@job.EmploymentType</td>

                                    <td>
                                        @job.PostedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(job.ClosingDate.HasValue
                                                                        ? job.ClosingDate.Value.ToString("dd MMM yyyy")
                                                                        : "Not specified")
                            </td>

                                    <td>
                                @if (job.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-controller="Jobs"
                                               asp-action="Edit"
                                               asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-pencil-square"></i>
                                                Edit
                                            </a>

                                            <form asp-controller="Jobs"
                                                  asp-action="ToggleStatus"
                                                  asp-route-id="@job.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to @(job.IsActive ? "deactivate" : "activate") this job?');">

                                                @Html.AntiForgeryToken()

                                                @if (job.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning">
                                                        <i class="bi bi-pause-circle"></i>
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-play-circle"></i>
                                                        Activate
                                                    </button>
                                                }
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4 class="text-white">No jobs posted yet</h4>

                    <p class="text-secondary">
                        Create your first job posting to get started.
                    </p>

                    <a asp-controller="Jobs"
                       asp-action="Create"
                       class="btn btn-primary">
                        Post Your First Job
                    </a>
                </div>
            }

        </div>
    </div>

</div>