@model AIRecruitmentSystem.Models.Job

@{
    ViewData["Title"] = "Post a Job";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="Jobs"
           asp-action="Index"
           class="btn btn-outline-light">
            ← Back to My Jobs
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <div class="card bg-dark text-white border-secondary shadow">
                <div class="card-header border-secondary p-4">
                    <h2 class="fw-bold mb-1">Post a New Job</h2>
                    <p class="text-secondary mb-0">
                        Add the details of the position you want to fill.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Jobs"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">
                                Job Title
                            </label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. Software Developer" />
                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Department"
                                       class="form-label">
                                    Department
                                </label>
                                <input asp-for="Department"
                                       class="form-control"
                                       placeholder="e.g. IT" />
                                <span asp-validation-for="Department"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Location"
                                       class="form-label">
                                    Location
                                </label>
                                <input asp-for="Location"
                                       class="form-control"
                                       placeholder="e.g. Pune / Remote" />
                                <span asp-validation-for="Location"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmploymentType"
                                   class="form-label">
                                Employment Type
                            </label>
                            <select asp-for="EmploymentType"
                                    class="form-select">
                                <option value="">Select employment type</option>
                                <option value="Full-Time">Full-Time</option>
                                <option value="Part-Time">Part-Time</option>
                                <option value="Internship">Internship</option>
                                <option value="Contract">Contract</option>
                                <option value="Remote">Remote</option>
                            </select>
                            <span asp-validation-for="EmploymentType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">
                                Job Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe the job role and responsibilities..."></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Requirements"
                                   class="form-label">
                                Requirements
                            </label>
                            <textarea asp-for="Requirements"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Add the skills, qualifications and experience required..."></textarea>
                            <span asp-validation-for="Requirements"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinimumSalary"
                                       class="form-label">
                                    Minimum Salary
                                </label>
                                <input asp-for="MinimumSalary"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="e.g. 25000" />
                                <span asp-validation-for="MinimumSalary"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaximumSalary"
                                       class="form-label">
                                    Maximum Salary
                                </label>
                                <input asp-for="MaximumSalary"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="e.g. 50000" />
                                <span asp-validation-for="MaximumSalary"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ClosingDate"
                                   class="form-label">
                                Application Closing Date
                            </label>
                            <input asp-for="ClosingDate"
                                   type="date"
                                   class="form-control" />
                            <span asp-validation-for="ClosingDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Publish Job
                            </button>

                            <a asp-controller="Jobs"
                               asp-action="Index"
                               class="btn btn-outline-light">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}