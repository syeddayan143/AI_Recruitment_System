
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AIRecruitmentSystem</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AIRecruitmentSystem.styles.css"
          asp-append-version="true" />

    <style>
        :root {
            color-scheme: dark;
            --app-bg: #101114;
            --app-surface: #191a20;
            --app-border: #2b2d37;
            --app-text: #f4f4f5;
            --app-muted: #a1a1aa;
            --app-accent: #8b5cf6;
            --app-cyan: #22d3ee;
        }

        html {
            min-height: 100%;
            background: var(--app-bg);
        }

        body.inner-page {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            background: var(--app-bg) !important;
            color: var(--app-text);
        }

            body.inner-page header {
                flex-shrink: 0;
            }

            body.inner-page .app-navbar {
                min-height: 72px;
                padding: 12px 0;
                background: rgba(19, 20, 26, .97) !important;
                border-bottom: 1px solid var(--app-border) !important;
                box-shadow: 0 8px 28px rgba(0, 0, 0, .18);
            }

        .app-brand {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #fff !important;
            font-size: 19px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .app-brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: linear-gradient(135deg, #8b5cf6, #06b6d4);
            color: #fff;
            font-size: 15px;
            font-weight: 900;
        }

        .app-brand-name span {
            color: var(--app-cyan);
        }

        .app-nav-link {
            padding: 10px 14px !important;
            border-radius: 9px;
            color: #b8bac5 !important;
            font-size: 14px;
            font-weight: 600;
            transition: background .2s ease, color .2s ease;
        }

            .app-nav-link:hover,
            .app-nav-link:focus {
                background: #25232f;
                color: #fff !important;
            }

        body.inner-page .navbar-toggler {
            border-color: #3a3b46;
            box-shadow: none;
        }

        body.inner-page .app-main {
            flex: 1;
            width: 100%;
            max-width: none;
            padding: 0 !important;
            margin: 0;
            background: var(--app-bg);
        }

        body.inner-page .app-footer {
            flex-shrink: 0;
            margin-top: 0 !important;
            padding: 22px 16px;
            border-top: 1px solid var(--app-border) !important;
            background: #14151a;
            color: var(--app-muted) !important;
            font-size: 13px;
        }

        .app-footer a {
            color: var(--app-cyan) !important;
        }

        body.inner-page .text-muted {
            color: var(--app-muted) !important;
        }

        body.inner-page .form-control,
        body.inner-page .form-select {
            border-color: #383945;
            background-color: #191a20;
            color: #f4f4f5;
        }

            body.inner-page .form-control:focus,
            body.inner-page .form-select:focus {
                border-color: var(--app-accent);
                box-shadow: 0 0 0 .2rem rgba(139, 92, 246, .18);
            }

            body.inner-page .form-control::placeholder {
                color: #777985;
            }

        body.inner-page .form-label {
            color: #dedee5;
        }

        @@media (max-width: 575.98px) {
            body.inner-page .app-navbar {
                min-height: 64px;
            }

            .app-brand {
                font-size: 16px;
            }

            body.inner-page .navbar-collapse {
                padding-top: 12px;
            }

            .app-nav-link {
                margin-top: 4px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(
      ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
      && ViewContext.RouteData.Values["action"]?.ToString() == "Index"
          ? "home-page"
          : "inner-page"
)">

    @{
        var isHomePage =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    }

    @if (!isHomePage)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
                <div class="container-fluid px-3 px-lg-4">

                    <a class="navbar-brand app-brand"
                       asp-controller="Home"
                       asp-action="Index">
                        <span class="app-brand-mark">AI</span>
                        <span class="app-brand-name">
                            Recruitment<span>System</span>
                        </span>
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse" id="mainNavbar">
                        <ul class="navbar-nav ms-auto align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Home"
                                   asp-action="Privacy">
                                    Privacy
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </nav>
        </header>
    }

    @if (isHomePage)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    }

    @if (!isHomePage)
    {
        <footer class="app-footer">
            <div class="container-fluid text-center">
                &copy; @DateTime.Now.Year AIRecruitmentSystem
                <span class="mx-2">·</span>
                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="text-decoration-none">
                    Privacy
                </a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
