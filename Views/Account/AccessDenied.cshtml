@model AIRecruitmentSystem.ViewModels.AccountResultViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title | RecruitAI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <main class="result-shell">
        <section class="result-card">
            <div class="result-icon result-icon-error">!</div>
            <span class="eyebrow">PERMISSION REQUIRED</span>
            <h1>@Model.Title</h1>
            <p>@Model.Message</p>
            <a class="btn auth-submit" asp-controller="Home" asp-action="Index">
                Return to home →
            </a>
        </section>
    </main>
</body>
</html>
