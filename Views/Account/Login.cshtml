@model AIRecruitmentSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In | AIRecruitmentSystem</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <main class="auth-shell">
        <section class="auth-intro">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">AI</span>
                <span>Recruit<span class="brand-accent">AI</span></span>
            </a>

            <div class="intro-content">
                <span class="eyebrow">WELCOME BACK</span>
                <h1>Your next opportunity could be <span>one step away.</span></h1>
                <p>Sign in to continue your recruitment journey and manage your professional opportunities.</p>

                <div class="feature-row">
                    <span class="feature-icon">✦</span>
                    <div>
                        <strong>Your career, organized</strong>
                        <p>Access your profile and applications in one place.</p>
                    </div>
                </div>

                <div class="feature-row">
                    <span class="feature-icon">↗</span>
                    <div>
                        <strong>Better connections</strong>
                        <p>Bring talent and opportunity closer together.</p>
                    </div>
                </div>
            </div>

            <p class="intro-footer">AI-powered recruitment, designed around people.</p>
        </section>

        <section class="auth-panel">
            <div class="auth-card login-card">
                <span class="eyebrow">YOUR WORKSPACE</span>
                <h2>Welcome back</h2>
                <p class="auth-subtitle">Enter your details to sign in to your account.</p>

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div class="field-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control auth-input" placeholder="you@example.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control auth-input" placeholder="Enter your password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="remember-row">
                        <label class="remember-label">
                            <input asp-for="RememberMe" />
                            <span>Remember me</span>
                        </label>
                    </div>

                    <button type="submit" class="btn auth-submit">Sign in <span>→</span></button>
                </form>

                <p class="auth-switch">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Create account</a>
                </p>

                <a class="back-home" asp-controller="Home" asp-action="Index">← Back to home</a>
            </div>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
