@model AIRecruitmentSystem.Models.JobApplication

@{
    ViewData["Title"] = "Application Details";

    var candidate = Model.Candidate;

    var profile = ViewBag.CandidateProfile
        as AIRecruitmentSystem.Models.CandidateProfile;

    var resume = Model.Resume;

    var interviews = ViewBag.Interviews
        as List<AIRecruitmentSystem.Models.Interview>
        ?? new List<AIRecruitmentSystem.Models.Interview>();

    var linkedInUrl = profile?.LinkedInUrl;
    var portfolioUrl = profile?.PortfolioUrl;

    var isValidLinkedIn = Uri.TryCreate(
        linkedInUrl, UriKind.Absolute, out var linkedInUri)
        && (linkedInUri.Scheme == Uri.UriSchemeHttps
            || linkedInUri.Scheme == Uri.UriSchemeHttp);

    var isValidPortfolio = Uri.TryCreate(
        portfolioUrl, UriKind.Absolute, out var portfolioUri)
        && (portfolioUri.Scheme == Uri.UriSchemeHttps
            || portfolioUri.Scheme == Uri.UriSchemeHttp);
}

<style>
    .application-page {
        padding: 28px 0 50px;
        color: #f3f4f6;
    }

    .application-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .application-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .application-subtitle {
        color: #9ca3af;
        margin: 0;
    }

    .application-card {
        background: #171b24;
        border: 1px solid #303746;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 22px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

        .application-card h4 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #f9fafb;
        }

    .detail-label {
        color: #9ca3af;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #f3f4f6;
        font-weight: 500;
        overflow-wrap: anywhere;
    }

    .detail-item {
        margin-bottom: 20px;
    }

    .detail-description {
        color: #d1d5db;
        white-space: pre-line;
        overflow-wrap: anywhere;
        line-height: 1.7;
    }

    .application-link {
        color: #8ab4ff;
        text-decoration: none;
        overflow-wrap: anywhere;
    }

        .application-link:hover {
            color: #b7d0ff;
            text-decoration: underline;
        }

    .status-badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #26364f;
        color: #b7d0ff;
        font-size: 13px;
        font-weight: 700;
    }

    .match-score {
        font-size: 24px;
        font-weight: 700;
        color: #86efac;
    }

    .application-page .form-label {
        color: #d1d5db;
        font-weight: 600;
    }

    .application-page .form-select,
    .application-page .form-control {
        background-color: #10141c;
        color: #f9fafb;
        border: 1px solid #3b4353;
        padding: 12px;
    }

        .application-page .form-select:focus,
        .application-page .form-control:focus {
            background-color: #10141c;
            color: #f9fafb;
            border-color: #719cff;
            box-shadow: 0 0 0 0.2rem rgba(113, 156, 255, 0.15);
        }

        .application-page .form-control::-webkit-calendar-picker-indicator {
            filter: invert(1);
        }

    .application-page .btn {
        border-radius: 9px;
        padding: 10px 16px;
        font-weight: 600;
    }

    .resume-box {
        background: #10141c;
        border: 1px solid #303746;
        border-radius: 12px;
        padding: 18px;
        overflow-wrap: anywhere;
    }

    .empty-value {
        color: #9ca3af;
        font-style: italic;
    }

    .interview-item {
        background: #10141c;
        border: 1px solid #303746;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 14px;
    }

        .interview-item:last-child {
            margin-bottom: 0;
        }

    .interview-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 18px;
        background: #203c32;
        color: #86efac;
        font-size: 12px;
        font-weight: 700;
    }

    .candidate-response-box {
        background: #171b24;
        border: 1px solid #374151;
        border-radius: 10px;
        padding: 14px;
        margin: 15px 0;
    }

    .response-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 18px;
        font-size: 12px;
        font-weight: 700;
    }

    .response-confirmed {
        background: #173d2b;
        color: #86efac;
    }

    .response-declined {
        background: #47272b;
        color: #fca5a5;
    }

    .response-pending {
        background: #45351b;
        color: #fcd34d;
    }

    .response-message {
        color: #d1d5db;
        margin: 10px 0 0;
        font-size: 14px;
    }

    .response-time {
        color: #9ca3af;
        font-size: 12px;
        margin-top: 8px;
    }

    @@media (max-width: 576px) {
        .application-page {
            padding-top: 18px;
        }

        .application-card {
            padding: 18px;
        }

        .application-title {
            font-size: 23px;
        }

        .application-header .btn {
            width: 100%;
        }
    }
</style>

<div class="container application-page">

    <div class="application-header">
        <div>
            <h2 class="application-title">Application Details</h2>
            <p class="application-subtitle">
                Review candidate information, manage the application and schedule interviews.
            </p>
        </div>

        <a asp-controller="RecruiterDashboard"
           asp-action="Applications"
           class="btn btn-outline-light">
            <i class="bi bi-arrow-left"></i>
            Back to Applications
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Application Overview -->
    <div class="application-card">
        <h4>Application Overview</h4>

        <div class="row">
            <div class="col-md-6 detail-item">
                <div class="detail-label">Application ID</div>
                <div class="detail-value">#@Model.Id</div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Application Status</div>
                <div>
                    <span class="status-badge">@Model.Status</span>
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Applied On</div>
                <div class="detail-value">
                    @Model.AppliedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Last Reviewed</div>
                <div class="detail-value">
                    @(Model.ReviewedAt.HasValue
                                        ? Model.ReviewedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        : "Not reviewed yet")
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Resume Match Score</div>
                <div class="match-score">
                    @(Model.MatchScore.HasValue
                                        ? Model.MatchScore.Value.ToString("0.##") + "%"
                                        : "Not available")
                </div>
            </div>
        </div>
    </div>

    <!-- Skill-Based Job Match Analysis -->
    @{
        var jobMatch = ViewBag.JobMatch as AIRecruitmentSystem.Services.JobMatchResult;
    }

    <div class="application-card">
        <h4>Skill-Based Job Match Analysis</h4>

        @if (resume == null || Model.Job == null)
        {
            <p class="empty-value mb-0">
                Match analysis is unavailable because the application resume or job information is missing.
            </p>
        }
        else if (jobMatch == null)
        {
            <p class="empty-value mb-0">
                Match analysis is not available for this application yet.
            </p>
        }
        else
        {
            <div class="row align-items-center">
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Skills Match</div>
                    <div class="match-score">@jobMatch.MatchPercentage%</div>
                </div>
                <div class="col-md-8 detail-item">
                    <div class="detail-label">Assessment</div>
                    <div class="detail-value">@jobMatch.Message</div>
                    <p class="text-secondary mt-2 mb-0">
                        This score compares recognized skills detected in the candidate's resume with recognized skills mentioned in the job requirements. It is a rule-based estimate, not a decision about the candidate's overall suitability.
                    </p>
                </div>
            </div>

            @if (jobMatch.MatchedSkills.Count > 0)
            {
                <div class="detail-item">
                    <div class="detail-label">Matched Required Skills</div>
                    <div class="detail-description">
                        @string.Join(", ", jobMatch.MatchedSkills)
                    </div>
                </div>
            }
            else
            {
                <div class="detail-item">
                    <div class="detail-label">Matched Required Skills</div>
                    <div class="empty-value">No recognized required skills matched.</div>
                </div>
            }

            @if (jobMatch.MissingSkills.Count > 0)
            {
                <div class="detail-item mb-0">
                    <div class="detail-label">Skills Not Detected in Resume</div>
                    <div class="detail-description">
                        @string.Join(", ", jobMatch.MissingSkills)
                    </div>
                </div>
            }
            else
            {
                <div class="detail-item mb-0">
                    <div class="detail-label">Skills Not Detected in Resume</div>
                    <div class="detail-value">No recognized required skills are missing.</div>
                </div>
            }
        }
    </div>

    <!-- Candidate Information -->
    <div class="application-card">
        <h4>Candidate Information</h4>

        <div class="row">
            <div class="col-md-6 detail-item">
                <div class="detail-label">Full Name</div>
                <div class="detail-value">
                    @(candidate?.FullName ?? "Not provided")
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Email Address</div>
                <div class="detail-value">
                    @if (!string.IsNullOrWhiteSpace(candidate?.Email))
                    {
                        <a class="application-link"
                           href="mailto:@candidate.Email">
                            @candidate.Email
                        </a>
                    }
                    else
                    {
                        <span class="empty-value">Not provided</span>
                    }
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Phone Number</div>
                <div class="detail-value">
                    @if (!string.IsNullOrWhiteSpace(candidate?.PhoneNumber))
                    {
                        <a class="application-link"
                           href="tel:@candidate.PhoneNumber">
                            @candidate.PhoneNumber
                        </a>
                    }
                    else
                    {
                        <span class="empty-value">Not provided</span>
                    }
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Current Job Title</div>
                <div class="detail-value">
                    @(profile?.CurrentJobTitle ?? "Not provided")
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Highest Education</div>
                <div class="detail-value">
                    @(profile?.HighestEducation ?? "Not provided")
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Experience</div>
                <div class="detail-value">
                    @(profile == null
                                        ? "Not provided"
                                        : profile.ExperienceYears + " years")
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Preferred Location</div>
                <div class="detail-value">
                    @(profile?.PreferredLocation ?? "Not provided")
                </div>
            </div>
        </div>
    </div>

    <!-- Candidate Skills and Links -->
    <div class="application-card">
        <h4>Skills &amp; Professional Profiles</h4>

        <div class="detail-item">
            <div class="detail-label">Candidate Skills</div>
            <div class="detail-description">
                @if (!string.IsNullOrWhiteSpace(profile?.Skills))
                {
                    @profile.Skills
                }
                else
                {
                    <span class="empty-value">No skills provided in profile.</span>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 detail-item">
                <div class="detail-label">LinkedIn Profile</div>
                <div class="detail-value">
                    @if (isValidLinkedIn)
                    {
                        <a class="application-link"
                           href="@linkedInUri!.AbsoluteUri"
                           target="_blank"
                           rel="noopener noreferrer">
                            View LinkedIn Profile
                        </a>
                    }
                    else
                    {
                        <span class="empty-value">Not provided</span>
                    }
                </div>
            </div>

            <div class="col-md-6 detail-item">
                <div class="detail-label">Portfolio Website</div>
                <div class="detail-value">
                    @if (isValidPortfolio)
                    {
                        <a class="application-link"
                           href="@portfolioUri!.AbsoluteUri"
                           target="_blank"
                           rel="noopener noreferrer">
                            View Portfolio
                        </a>
                    }
                    else
                    {
                        <span class="empty-value">Not provided</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Resume -->
    <div class="application-card">
        <h4>Candidate Resume</h4>

        @if (resume != null && resume.CandidateId == Model.CandidateId)
        {
            <div class="resume-box">
                <div class="detail-label">Selected Resume</div>
                <div class="detail-value mb-3">
                    @resume.OriginalFileName
                </div>

                <div class="detail-label">Uploaded On</div>
                <div class="detail-value mb-3">
                    @resume.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")
                </div>

                @if (resume.ResumeScore.HasValue)
                {
                    <div class="detail-label">Resume Score</div>
                    <div class="detail-value mb-3">
                        @resume.ResumeScore.Value
                    </div>
                }

                <a asp-controller="RecruiterDashboard"
                   asp-action="ViewResume"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary"
                   target="_blank"
                   rel="noopener noreferrer">
                    <i class="bi bi-file-earmark-text"></i>
                    View Resume
                </a>
            </div>
        }
        else
        {
            <p class="empty-value mb-0">
                No resume is attached to this application.
            </p>
        }
    </div>

    <!-- Job Information -->
    <div class="application-card">
        <h4>Job Information</h4>

        @if (Model.Job != null)
        {
            <div class="row">
                <div class="col-md-6 detail-item">
                    <div class="detail-label">Job Title</div>
                    <div class="detail-value">@Model.Job.Title</div>
                </div>

                <div class="col-md-6 detail-item">
                    <div class="detail-label">Department</div>
                    <div class="detail-value">
                        @(Model.Job.Department ?? "Not specified")
                    </div>
                </div>

                <div class="col-md-6 detail-item">
                    <div class="detail-label">Location</div>
                    <div class="detail-value">
                        @(Model.Job.Location ?? "Not specified")
                    </div>
                </div>

                <div class="col-md-6 detail-item">
                    <div class="detail-label">Employment Type</div>
                    <div class="detail-value">
                        @(Model.Job.EmploymentType ?? "Not specified")
                    </div>
                </div>

                <div class="col-md-6 detail-item">
                    <div class="detail-label">Minimum Salary</div>
                    <div class="detail-value">
                        @(Model.Job.MinimumSalary.HasValue
                                            ? Model.Job.MinimumSalary.Value.ToString("N0")
                                            : "Not specified")
                                                          </div>
                                                      </div>

                <div class="col-md-6 detail-item">
                    <div class="detail-label">Maximum Salary</div>
                    <div class="detail-value">
                        @(Model.Job.MaximumSalary.HasValue
                                            ? Model.Job.MaximumSalary.Value.ToString("N0")
                                            : "Not specified")
                </div>
            </div>
        </div>

            <div class="detail-item">
                <div class="detail-label">Job Description</div>
                <div class="detail-description">
                    @Model.Job.Description
                </div>
            </div>

        @if (!string.IsNullOrWhiteSpace(Model.Job.Requirements))
            {
                <div class="detail-item mb-0">
                    <div class="detail-label">Job Requirements</div>
                    <div class="detail-description">
                        @Model.Job.Requirements
                    </div>
                </div>
            }
        }
        else
        {
            <p class="empty-value mb-0">
                Job information is not available.
            </p>
        }
    </div>

    <!-- Schedule Interview -->
    <div class="application-card">
        <h4>Schedule Interview</h4>

        <p class="text-secondary mb-4">
            Select an interview date, time and type for this candidate.
        </p>

        <form asp-controller="RecruiterDashboard"
              asp-action="ScheduleInterview"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="applicationId"
                   value="@Model.Id" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="scheduledAt" class="form-label">
                        Interview Date &amp; Time
                    </label>

                    <input type="datetime-local"
                           id="scheduledAt"
                           name="scheduledAt"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-6 mb-3">
                    <label for="interviewType" class="form-label">
                        Interview Type
                    </label>

                    <select id="interviewType"
                            name="interviewType"
                            class="form-select"
                            required>
                        <option value="Online">Online</option>
                        <option value="In-Person">In-Person</option>
                        <option value="Phone">Phone</option>
                    </select>
                </div>

                <div class="col-12 mb-3">
                    <label for="meetingLink" class="form-label">
                        Meeting Link (for online interviews)
                    </label>

                    <input type="url"
                           id="meetingLink"
                           name="meetingLink"
                           class="form-control"
                           maxlength="500"
                           placeholder="https://meet.google.com/..." />

                    <small class="text-secondary">
                        Required for online interviews. Optional for other types.
                    </small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-calendar-check"></i>
                Schedule Interview
            </button>
        </form>
    </div>

    <!-- Scheduled Interviews with Candidate Response -->
    <div class="application-card">
        <h4>Scheduled Interviews</h4>

        @if (interviews.Count > 0)
        {
            @foreach (var interview in interviews)
            {
                var candidateResponse =
                interview.CandidateResponse ?? "Pending";

                var responseClass = candidateResponse switch
                {
                    "Confirmed" => "response-confirmed",
                    "Declined" => "response-declined",
                    _ => "response-pending"
                };

                <div class="interview-item">

                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <div class="detail-label">Interview Date &amp; Time</div>
                            <div class="detail-value">
                                @interview.ScheduledAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>

                        <span class="interview-status">
                            @interview.Status
                        </span>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Interview Type</div>
                        <div class="detail-value">
                            @interview.InterviewType
                        </div>
                    </div>

                    <!-- Candidate Response -->
                    <div class="candidate-response-box">
                        <div class="detail-label">
                            Candidate Interview Response
                        </div>

                        <span class="response-badge @responseClass">
                            @candidateResponse
                        </span>

                        @if (candidateResponse == "Confirmed")
                        {
                            <p class="response-message">
                                <i class="bi bi-check-circle"></i>
                                Candidate has confirmed attendance.
                            </p>
                        }
                        else if (candidateResponse == "Declined")
                        {
                            <p class="response-message">
                                <i class="bi bi-x-circle"></i>
                                Candidate has declined this interview.
                            </p>
                        }
                        else
                        {
                            <p class="response-message">
                                <i class="bi bi-clock"></i>
                                Waiting for the candidate's response.
                            </p>
                        }

                        @if (interview.CandidateRespondedAt.HasValue)
                        {
                            <div class="response-time">
                                Response submitted:
                                @interview.CandidateRespondedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(interview.MeetingLink)
                                && Uri.TryCreate(
                                interview.MeetingLink,
                                UriKind.Absolute,
                                out var meetingUri)
                                && (meetingUri.Scheme == Uri.UriSchemeHttps
                                || meetingUri.Scheme == Uri.UriSchemeHttp))
                    {
                        <div class="detail-item">
                            <div class="detail-label">Meeting Link</div>
                            <a class="application-link"
                               href="@meetingUri.AbsoluteUri"
                               target="_blank"
                               rel="noopener noreferrer">
                                Open Meeting Link
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(interview.Feedback))
                    {
                        <div class="detail-item mt-3 mb-0">
                            <div class="detail-label">Interview Feedback</div>
                            <div class="detail-description">
                                @interview.Feedback
                            </div>
                        </div>
                    }

                    @if (interview.InterviewScore.HasValue)
                    {
                        <div class="detail-item mt-3 mb-0">
                            <div class="detail-label">Interview Score</div>
                            <div class="detail-value">
                                @interview.InterviewScore.Value.ToString("0.##")%
                            </div>
                        </div>
                    }

                </div>
            }
        }
        else
        {
            <p class="empty-value mb-0">
                No interviews have been scheduled for this application yet.
            </p>
        }
    </div>

    <!-- Update Application Status -->
    <div class="application-card">
        <h4>Update Application Status</h4>

        <p class="text-secondary mb-3">
            Select the appropriate status after reviewing this candidate.
        </p>

        <form asp-controller="RecruiterDashboard"
              asp-action="UpdateApplicationStatus"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label for="status" class="form-label">
                    New Application Status
                </label>

                <select id="status"
                        name="status"
                        class="form-select"
                        required>

                    @foreach (var status in new[]
                                        {
                                        "Applied",
                                        "Under Review",
                                        "Shortlisted",
                                        "Interview Scheduled",
                                        "Rejected",
                                        "Hired"
                                        })
                    {
                        if (Model.Status == status)
                        {
                            <option value="@status" selected>
                                @status
                            </option>
                        }
                        else
                        {
                            <option value="@status">
                                @status
                            </option>
                        }
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i>
                Update Status
            </button>
        </form>
    </div>

</div>
