@model AIRecruitmentSystem.Controllers.RecruiterDashboardViewModel

@{
    ViewData["Title"] = "Recruiter Dashboard";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="text-white fw-bold mb-1">Recruiter Dashboard</h1>
            <p class="text-secondary mb-0">
                Manage your job postings and track candidate applications.
            </p>
        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                Logout
            </button>
        </form>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-controller="Jobs"
           asp-action="Index"
           class="btn btn-outline-light">
            View Jobs
        </a>

        <a asp-controller="Jobs"
           asp-action="Create"
           class="btn btn-primary">
            + Post New Job
        </a>

        <a asp-controller="RecruiterDashboard"
           asp-action="Applications"
           class="btn btn-outline-info">
            View Applications
        </a>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-12 col-md-4">
            <div class="card bg-dark text-white border-secondary shadow h-100">
                <div class="card-body">
                    <p class="text-secondary mb-2">My Total Jobs</p>
                    <h2 class="fw-bold mb-0">@Model.TotalJobs</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card bg-dark text-white border-secondary shadow h-100">
                <div class="card-body">
                    <p class="text-secondary mb-2">Active Jobs</p>
                    <h2 class="fw-bold mb-0">@Model.ActiveJobs</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card bg-dark text-white border-secondary shadow h-100">
                <div class="card-body">
                    <p class="text-secondary mb-2">Total Applications</p>
                    <h2 class="fw-bold mb-0">@Model.TotalApplications</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header border-secondary py-3">
            <h4 class="mb-0 fw-semibold">My Recent Jobs</h4>
        </div>

        <div class="card-body">

            @if (Model.RecentJobs != null && Model.RecentJobs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Job Title</th>
                                <th>Location</th>
                                <th>Posted Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var job in Model.RecentJobs)
                            {
                                <tr>
                                    <td>@job.Title</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(job.Location)
                                                                        ? "Not specified"
                                                                        : job.Location)
                            </td>
                            <td>@job.PostedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                @if (job.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5 class="text-white">No jobs posted yet</h5>
                    <p class="text-secondary">
                        Create your first job posting to get started.
                    </p>

                    <a asp-controller="Jobs"
                       asp-action="Create"
                       class="btn btn-primary">
                        Post Your First Job
                    </a>
                </div>
            }

        </div>
    </div>

</div>
