@model List<AIRecruitmentSystem.Controllers.AdminUserRowViewModel>

@{
    Layout = null;
    ViewData["Title"] = "User Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Management | AI Recruitment System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: #101114;
            color: #f4f5f7;
            font-family: Inter, sans-serif;
        }

        .page {
            max-width: 1400px;
            margin: auto;
            padding: 30px 20px;
        }

        .panel {
            background: rgba(255,255,255,.045);
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 18px;
            padding: 24px;
        }

        .muted {
            color: #a5a6b0;
        }

        .btn-soft, .form-control, .form-select {
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 10px;
        }

        .btn-soft {
            color: #f4f5f7;
            background: transparent;
            padding: 9px 14px;
            text-decoration: none;
        }

            .btn-soft:hover {
                color: #fff;
                background: rgba(255,255,255,.08);
            }

        .form-control, .form-select {
            color: #f4f5f7;
            background-color: #191a20;
            padding: 11px 12px;
        }

            .form-control:focus, .form-select:focus {
                color: #fff;
                background-color: #191a20;
                border-color: #9d8bff;
                box-shadow: 0 0 0 .2rem rgba(157,139,255,.12);
            }

            .form-select option {
                color: #fff;
                background: #191a20;
            }

        .table {
            --bs-table-bg: transparent;
            --bs-table-color: #f4f5f7;
            --bs-table-border-color: rgba(255,255,255,.09);
            vertical-align: middle;
        }

            .table th {
                color: #a5a6b0;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

        .pill {
            display: inline-block;
            border-radius: 30px;
            padding: 5px 9px;
            margin: 2px;
            font-size: 11px;
            background: rgba(157,139,255,.13);
            color: #c5baff;
        }

        .active {
            background: #183c2d;
            color: #79e2a9;
        }

        .inactive {
            background: #432327;
            color: #ff9ca6;
        }

        .alert {
            border-radius: 12px;
        }

        @@media (max-width: 600px) {
            .page {
                padding: 18px 10px;
            }

            .panel {
                padding: 14px;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <header class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <div class="muted small mb-1">ADMINISTRATION</div>
                <h1 class="h3 fw-bold mb-1">User Management</h1>
                <p class="muted mb-0">Manage registered Candidate and Recruiter accounts.</p>
            </div>

            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="btn-soft">← Dashboard</a>
        </header>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <section class="panel">
            <form method="get" asp-controller="AdminUsers" asp-action="Index"
                  class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label class="form-label muted" for="search">Search users</label>
                    <input class="form-control"
                           id="search"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search by name or email" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label muted" for="role">Account role</label>
                    <select class="form-select" id="role" name="role">
                        <option value="">All roles</option>
                        <option value="Candidate"
                                selected="@(ViewBag.SelectedRole as string == "Candidate")">
                            Candidate
                        </option>
                        <option value="Recruiter"
                                selected="@(ViewBag.SelectedRole as string == "Recruiter")">
                            Recruiter
                        </option>
                        <option value="Admin"
                                selected="@(ViewBag.SelectedRole as string == "Admin")">
                            Admin
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-3 d-flex align-items-end gap-2">
                    <button class="btn btn-primary flex-grow-1" type="submit">
                        Search
                    </button>
                    <a asp-action="Index" class="btn-soft">Reset</a>
                </div>
            </form>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 fw-bold mb-0">Registered Accounts</h2>
                <span class="muted small">@Model.Count users</span>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Joined</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center muted py-4">
                                    No matching users found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@user.FullName</div>
                                        <div class="muted small">@user.Email</div>
                                    </td>
                                    <td>
                                        @foreach (var roleName in user.Roles)
                                        {
                                            <span class="pill">@roleName</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="pill active">Active</span>
                                        }
                                        else
                                        {
                                            <span class="pill inactive">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!user.Roles.Contains("Admin"))
                                        {
                                            <form asp-controller="AdminUsers"
                                                  asp-action="ToggleStatus"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                @if (user.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Activate
                                                    </button>
                                                }
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="muted small">Protected</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
