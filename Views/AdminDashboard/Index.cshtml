@model AIRecruitmentSystem.Controllers.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Dashboard Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-white fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-secondary mb-0">
                Welcome to the AI Recruitment System administration panel.
            </p>
        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                Logout
            </button>
        </form>
    </div>

    <!-- Manage Users Button -->
    <div class="mb-4">
        <a asp-controller="AdminUsers"
           asp-action="Index"
           class="btn btn-outline-light">
            Manage Users →
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-5">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow">
                <div class="card-body">
                    <p class="text-secondary mb-2">Total Users</p>
                    <h2 class="fw-bold mb-0">@Model.TotalUsers</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow">
                <div class="card-body">
                    <p class="text-secondary mb-2">Active Users</p>
                    <h2 class="fw-bold mb-0">@Model.ActiveUsers</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow">
                <div class="card-body">
                    <p class="text-secondary mb-2">Recruiters</p>
                    <h2 class="fw-bold mb-0">@Model.TotalRecruiters</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow">
                <div class="card-body">
                    <p class="text-secondary mb-2">Candidates</p>
                    <h2 class="fw-bold mb-0">@Model.TotalCandidates</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow">
                <div class="card-body">
                    <p class="text-secondary mb-2">Total Jobs</p>
                    <h2 class="fw-bold mb-0">@Model.TotalJobs</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow">
                <div class="card-body">
                    <p class="text-secondary mb-2">Total Applications</p>
                    <h2 class="fw-bold mb-0">@Model.TotalApplications</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Registrations -->
    <div class="card bg-dark text-white border-secondary shadow">

        <div class="card-header border-secondary py-3">
            <h4 class="mb-0 fw-semibold">Recent Registrations</h4>
        </div>

        <div class="card-body">

            @if (Model.RecentUsers != null && Model.RecentUsers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Registration Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td>
                                        @user.FullName
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-secondary mb-0">
                        No registered users found.
                    </p>
                </div>
            }

        </div>
    </div>

</div>